<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              name="sales_report" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="SHOP_NAME" class="java.lang.String"/>
    <parameter name="PRINTED_BY" class="java.lang.String"/>

    <queryString>
        <![CDATA[
        SELECT s.id AS sale_id,
               s.sale_date,
               c.name AS customer_name,
               cat.name AS category,
               p.name AS product_name,
               si.quantity,
               si.unit_price,
               si.line_total
        FROM sales s
        JOIN customers c   ON c.id = s.customer_id
        JOIN sale_items si ON si.sale_id = s.id
        JOIN products p    ON p.id = si.product_id
        JOIN categories cat ON cat.id = p.category_id
        ORDER BY s.sale_date DESC, s.id DESC
        ]]>
    </queryString>

    <field name="sale_id" class="java.lang.Integer"/>
    <field name="sale_date" class="java.sql.Timestamp"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="category" class="java.lang.String"/>
    <field name="product_name" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="unit_price" class="java.math.BigDecimal"/>
    <field name="line_total" class="java.math.BigDecimal"/>

    <variable name="GRAND_TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{line_total}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="65">
            <textField>
                <reportElement x="0" y="0" width="802" height="30"/>
                <textElement><font size="20" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{SHOP_NAME}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="34" width="400" height="22"/>
                <textElement><font size="14"/></textElement>
                <text><![CDATA[Sales Report (item level)]]></text>
            </staticText>
            <textField>
                <reportElement x="402" y="34" width="400" height="22"/>
                <textElement textAlignment="Right"><font size="11"/></textElement>
                <textFieldExpression><![CDATA["Printed by: " + $P{PRINTED_BY}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement mode="Opaque" backcolor="#6D4C41" forecolor="#FFFFFF" x="0" y="0" width="50" height="24"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Bill #]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#6D4C41" forecolor="#FFFFFF" x="50" y="0" width="120" height="24"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Date]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#6D4C41" forecolor="#FFFFFF" x="170" y="0" width="150" height="24"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Customer]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#6D4C41" forecolor="#FFFFFF" x="320" y="0" width="90" height="24"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Category]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#6D4C41" forecolor="#FFFFFF" x="410" y="0" width="170" height="24"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Product]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#6D4C41" forecolor="#FFFFFF" x="580" y="0" width="40" height="24"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#6D4C41" forecolor="#FFFFFF" x="620" y="0" width="85" height="24"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Unit Price]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#6D4C41" forecolor="#FFFFFF" x="705" y="0" width="97" height="24"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Line Total]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField>
                <reportElement x="0" y="0" width="50" height="22"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{sale_id}]]></textFieldExpression>
            </textField>
            <textField pattern="yyyy-MM-dd HH:mm">
                <reportElement x="50" y="0" width="120" height="22"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{sale_date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="170" y="0" width="150" height="22"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{customer_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="90" height="22"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{category}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="410" y="0" width="170" height="22"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{product_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="580" y="0" width="40" height="22"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="620" y="0" width="85" height="22"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{unit_price}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="705" y="0" width="97" height="22"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{line_total}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="22">
            <textField>
                <reportElement x="0" y="2" width="802" height="18"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="40">
            <staticText>
                <reportElement x="420" y="10" width="285" height="22"/>
                <box rightPadding="4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Total of all items (before bill discounts):]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="705" y="10" width="97" height="22"/>
                <box leftPadding="4" rightPadding="4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{GRAND_TOTAL}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
